# The site builds to static files and needs no environment to run.
#
# Enquiry delivery is handled on the server by public/send-enquiry.php, which
# mails to the address set at the top of that file. There is no API key.

# Only needed to build against a domain other than the live one in lib/site.ts
# — a staging URL, for example. Leave blank for a production build.
NEXT_PUBLIC_SITE_URL=
