# Enquiry delivery (app/api/enquiries/route.ts)
# Until all three are set, the form reports that nothing was sent.

# Where enquiries are delivered — the address to receive form submissions.
CONTACT_TO_EMAIL=

# Verified sender on your Resend domain, e.g. "Big Rock Builders <no-reply@yourdomain.com>"
CONTACT_FROM_EMAIL=

# https://resend.com/api-keys
RESEND_API_KEY=

# Canonical origin for canonical tags, Open Graph and the sitemap.
# Must be the live domain before deploying, e.g. https://bigrockbuilders.com
# Without it the build falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
