# Big Rock Builders — Apache configuration for shared hosting.
#
# Uploaded alongside the exported site. Everything here is optional to the
# site working, but it is what makes it serve correctly and quickly.

# ----------------------------------------------------------------------
# Force HTTPS
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # StackCP terminates TLS upstream, so HTTPS is signalled by this header
  # rather than by the usual HTTPS variable.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------------------
# The site's own 404 page, rather than the host's
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Caching
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Built assets carry a content hash in the filename, so a given URL never
  # changes and can be cached indefinitely.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images keep their names across deploys, so they are re-checked weekly.
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png  "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"

  # Pages must not be cached, or a deploy would not reach people who have
  # already visited.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Keep the directory listing off, in case an index file is ever missing.
Options -Indexes
